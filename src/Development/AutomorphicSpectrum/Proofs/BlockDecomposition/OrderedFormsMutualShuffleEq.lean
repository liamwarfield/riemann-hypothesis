      (a b : M),
      (UpperTheory.Reformulated.B.Gwa2.twKer ρ N θ).mapQ (UpperTheory.Reformulated.B.Gwa2.twKer ρ N θ) ((ρ : G → V →ₗ[ℂ] V) ((s : M → G) (a * b)))
