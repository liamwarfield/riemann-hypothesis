def embBar (v : Pl (F := F)) : E →ₐ[F] FvBar F v := IsAlgClosed.lift

variable {F E} {J : Type} [Fintype J]

def supBar (v : Pl (F := F)) (τ : E →ₐ[F] FvBar F v) (u : J → E) : ℝ≥0 :=
  Finset.univ.sup fun f => absBar F v (τ (u f))

