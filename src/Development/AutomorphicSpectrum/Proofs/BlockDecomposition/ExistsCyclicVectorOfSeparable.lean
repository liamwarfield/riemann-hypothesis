      continuous_invFun := hcont g⁻¹ }
  obtain ⟨u, rfl⟩ := hl
  let am := algebraMap R (R ⊗[F] E)
  have hinv : ∀ (v w : Rˣ) (_ : (v : R) * w = 1) (A : HermR R σ n),
