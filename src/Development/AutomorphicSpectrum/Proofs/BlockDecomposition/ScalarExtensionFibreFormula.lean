  have hae : ∀ᵐ p ∂(μ.prod ν), ‖(φ ∘ f) p‖ ≤ (C₁ ×ˢ C₂).indicator (fun _ => |Bd|) p := by
    have h := (Measure.quasiMeasurePreserving_fst (μ := μ) (ν := ν)).ae hs
    filter_upwards [h] with p hp
