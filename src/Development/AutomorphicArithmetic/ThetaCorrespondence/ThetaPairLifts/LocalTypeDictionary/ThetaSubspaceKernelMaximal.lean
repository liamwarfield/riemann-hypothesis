private theorem inv_mem_local {D : D7} (X : HSp D) {d : ℕ} (e : Fin X.rank ≃ Fin d)
    {J : Matrix (Fin d) (Fin d) D.host.E} (hJ : J = D.host.xi0 • reindex e e X.gramᵀ)
    (x : GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.UB J) :
    Units.map (Matrix.reindexAlgEquiv (AE D) (AE D) e.symm).toMonoidHom x.1 ∈
      HR (AF D.host.F) D.sp.cm.sig X.gram := by
  have hx : (x.1.1 : Matrix (Fin d) (Fin d) (AE D))ᵀ * GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM J *
      (x.1.1 : Matrix (Fin d) (Fin d) (AE D)).map (cA D) = GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM J := x.2
  show (((x.1.1 : Matrix (Fin d) (Fin d) (AE D)).submatrix e e).map (cA D))ᵀ * GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM X.gram *
    (x.1.1 : Matrix (Fin d) (Fin d) (AE D)).submatrix e e = GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM X.gram
  generalize (x.1.1 : Matrix (Fin d) (Fin d) (AE D)) = Y at hx ⊢
  rw [hJ, GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM_smul, Matrix.mul_smul, Matrix.smul_mul] at hx
  have hx' := congrArg (fun y => incA D (D.host.xi0)⁻¹ • y) hx
  simp only [smul_smul, ← map_mul, inv_mul_cancel₀ (GlobalTheory.DualPairCompare.embedding_xi_zero_ne_zero D), map_one, one_smul] at hx'
  have e1 : GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM (reindex e e X.gramᵀ) =
      reindex e e (GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.incM X.gram)ᵀ := rfl
  rw [e1] at hx'
  have hs := congrArg (fun y => y.submatrix e e) hx'
  simp only [reindex_apply] at hs
  rw [← submatrix_mul_equiv _ _ _ e _, ← submatrix_mul_equiv _ _ _ e _] at hs
  simp only [submatrix_submatrix, Equiv.symm_comp_self, submatrix_id_id, ← transpose_submatrix] at hs
  have ht := congrArg transpose hs
  rw [transpose_mul, transpose_mul, transpose_transpose, transpose_transpose, ← Matrix.mul_assoc] at ht
  exact ht

set_option maxHeartbeats 1600000 in
private theorem kapX_onto_local : ∀ (D : D7) (X : HSp D) {d : ℕ} (e : Fin X.rank ≃ Fin d)
    (Wd : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Spc D.host.F D.host.E d)
    (hJ : Wd.J = D.host.xi0 • reindex e e X.gramᵀ)
    (v : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Pl (F := D.host.F)),
    ∀ h ∈ GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.UAt D.sp.cm.sig Wd (GlobalTheory.AdelicU.evFin D.host.F v),
    ∃ h' ∈ GfC X, kapX X e hJ h' = h := by
  intro D X d e Wd hJ v h hh
  let h' : GA D X := ⟨Units.map (Matrix.reindexAlgEquiv (AE D) (AE D) e.symm).toMonoidHom h.1, inv_mem_local X e hJ h⟩
  refine ⟨h', ?_, ?_⟩
  · set a : AF D.host.F := 1 - GlobalTheory.EmbChart.atPlace v 1 with ha
    have h0 : GlobalTheory.AdelicU.evFin D.host.F v a = 0 := by
      rw [ha, map_sub, map_one, GlobalTheory.EmbChart.evFin_atPlace, sub_self]
    have h1 : fstA D.host.F a = 1 := by
      show (1 : Ainf D.host.F) - (0 : Ainf D.host.F) = 1
      exact sub_zero 1
    let f := Algebra.TensorProduct.map (fstA D.host.F) (AlgHom.id D.host.F D.host.E)
    have hf1 : f (a ⊗ₜ[D.host.F] (1 : D.host.E)) = 1 := by
      simp only [f, Algebra.TensorProduct.map_tmul, AlgHom.coe_id, id_eq, h1]
      rfl
    have hz : ∀ i j, f ((GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.mat h - 1) i j) = 0 := by
      intro i j
      have k := congrFun (congrFun (hh a h0) i) j
      rw [Matrix.smul_apply, Matrix.zero_apply, Algebra.smul_def, Algebra.TensorProduct.algebraMap_apply,
        Algebra.algebraMap_self, RingHom.id_apply] at k
      have k2 := congrArg f k
      rw [map_mul, map_zero, hf1, one_mul] at k2
      exact k2
    rw [GfC, MonoidHom.mem_ker]
    apply Units.ext
    ext i j
    show f (GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.mat h (e i) (e j)) = (1 : Matrix (Fin X.rank) (Fin X.rank) _) i j
    have e2 : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.mat h (e i) (e j) =
        (GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.mat h - 1) (e i) (e j) + (1 : Matrix (Fin d) (Fin d) (AE D)) (e i) (e j) := by
      rw [Matrix.sub_apply, sub_add_cancel]
    rw [e2, map_add (f := _), hz, zero_add]
    by_cases hij : i = j
    · subst hij
      rw [Matrix.one_apply_eq (α := AF D.host.F ⊗[D.host.F] D.host.E), map_one,
        Matrix.one_apply_eq (α := Ainf D.host.F ⊗[D.host.F] D.host.E)]
    · rw [Matrix.one_apply_ne (α := AF D.host.F ⊗[D.host.F] D.host.E) (e.injective.ne hij), map_zero,
        Matrix.one_apply_ne (α := Ainf D.host.F ⊗[D.host.F] D.host.E) hij]
  · apply Subtype.ext
    apply Units.ext
    ext i j
    show (h.1.1 : Matrix (Fin d) (Fin d) (AE D)) (e (e.symm i)) (e (e.symm j)) = h.1.1 i j
    simp only [Equiv.apply_symm_apply]

theorem GlobalTheory.SquareAgree.kernel_maximal_theta_subspace : _root_.GlobalTheory.FunPr.ThetaLocalInputs → ∀ (D : D7) (ψ : AddChar (AF D.host.F) ℂ) (θ : InfFam D) (W W₁ X : HSp D) (A : Fr W) (A₁ : Fr W₁)
    (B : Fr X) (α β : (AE D)ˣ →* Circle) (ν : Measure (GA D W)) (𝓕 : Set (GA D W)) (ν₁ : Measure (GA D W₁))
    (𝓕₁ : Set (GA D W₁)) (ωA : WRep W X) (ωB : WRep W₁ X) (e : Fin X.rank ≃ Fin (W.rank + W₁.rank))
    (Bs : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Base D.host.F D.host.E) (Γ : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Geo D.sp.cm.sig W.rank W₁.rank)
    (Xc : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Chars D.host.F D.host.E) (om : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V Γ.W)
    (om' : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.Rep D.sp.cm.sig Γ.V' Γ.W) (cA : Matrix (Fin W.rank) (Fin (W.rank + W₁.rank)) (AE D) ≃+ WO W X)
    (cB : Matrix (Fin W₁.rank) (Fin (W.rank + W₁.rank)) (AE D) ≃+ WO W₁ X),
    IsInfFam θ → IsTriple W W₁ X α β → IsOver ψ θ A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB →
    GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.IsTriple Bs Γ Xc om om' →
    ∀ Pi rf rl p p', IsMatch ψ θ A A₁ B α β ωA ωB Pi rf rl p p' →
    ∃ K, GlobalTheory.CoinvKer.IsThetaSub om Bs.emb (algD Γ.M Bs.ψ Bs.emb) K ∧ K ≠ algD Γ.M Bs.ψ Bs.emb ∧
      (∀ N, GlobalTheory.CoinvKer.IsThetaSub om Bs.emb (algD Γ.M Bs.ψ Bs.emb) N → K ≤ N → N = K ∨ N = algD Γ.M Bs.ψ Bs.emb) ∧
      ∀ Φ ∈ algF ψ θ true A B, ∀ ΦD ∈ algD Γ.M Bs.ψ Bs.emb, IsDatum Γ.M ψ cA ΦD Φ → (ΦD ∈ K ↔ p Φ = 0) := by
  intro hP D ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT Pi rf rl p p' hm
  have hpsi := hO.psi
  subst hpsi
  have hstd : GlobalTheory.IndefiniteRowSideFullHecke.WeilTensorModels.IsStd Bs.ψ := hT.base.std
  let dF : ((Fin W.rank × Fin (W.rank + W₁.rank) → AF D.host.F) → ℂ) → (WO W X → ℂ) :=
    fun ΦD x => GlobalTheory.WeilM.thetaSum D.host.F (Γ.M.co.rho Bs.ψ (cA.symm x) ΦD)
  have hdat : ∀ ΦD f, IsDatum Γ.M Bs.ψ cA ΦD f → f = dF ΦD := by
    intro ΦD f h
    funext x
    have := h.2 (cA.symm x)
    rw [AddEquiv.apply_symm_apply] at this
    exact this.symm
  have hdat' : ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)), IsDatum Γ.M Bs.ψ cA ΦD (dF ΦD) := by
    intro ΦD h
    refine ⟨h, fun u => ?_⟩
    show _ = GlobalTheory.WeilM.thetaSum D.host.F (Γ.M.co.rho Bs.ψ (cA.symm (cA u)) ΦD)
    rw [AddEquiv.symm_apply_apply]
  have hS : ∀ ΦD ∈ algD Γ.M Bs.ψ Bs.emb, ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)) := by
    intro ΦD h
    obtain ⟨_, _, hd⟩ := hO.algA' ΦD h
    exact hd.1
  have dF_sub : ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)),
      ∀ ΨD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)), dF (ΦD - ΨD) = dF ΦD - dF ΨD := by
    intro ΦD h ΨD h'
    exact (hdat _ _ (GlobalTheory.SquareAgree.CoinvPass.isDatum_sub hstd (hdat' ΦD h) (hdat' ΨD h'))).symm
  have dF_add : ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)),
      ∀ ΨD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)), dF (ΦD + ΨD) = dF ΦD + dF ΨD := by
    intro ΦD h ΨD h'
    exact (hdat _ _ (GlobalTheory.SquareAgree.CoinvPass.isDatum_add hstd (hdat' ΦD h) (hdat' ΨD h'))).symm
  have dF_smul : ∀ (c : ℂ), ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)),
      dF (c • ΦD) = c • dF ΦD := by
    intro c ΦD h
    exact (hdat _ _ (GlobalTheory.SquareAgree.CoinvPass.isDatum_smul c (hdat' ΦD h))).symm
  have dF_zero : dF 0 = 0 := (hdat _ _ GlobalTheory.SquareAgree.CoinvPass.isDatum_zero).symm
  have hAlgF : ∀ ΦD ∈ algD Γ.M Bs.ψ Bs.emb, dF ΦD ∈ algF Bs.ψ θ true A B := by
    intro ΦD h
    obtain ⟨Φ, hΦ, hd⟩ := hO.algA' ΦD h
    rw [← hdat _ _ hd]; exact hΦ
  have inj : ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)),
      ∀ ΨD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)), dF ΦD = dF ΨD → ΦD = ΨD := by
    intro ΦD h ΨD h' he
    have h0 := GlobalTheory.T.eq_zero_of_thetaDistribution_heisenbergTranslates Γ.M Bs.ψ hstd (ΦD - ΨD) (sub_mem h h') (fun u => by
      have := congrFun (dF_sub ΦD h ΨD h') (cA u)
      rw [he, sub_self] at this
      have e2 : dF (ΦD - ΨD) (cA u) = GlobalTheory.WeilM.thetaSum D.host.F (Γ.M.co.rho Bs.ψ u (ΦD - ΨD)) := by
        show GlobalTheory.WeilM.thetaSum D.host.F (Γ.M.co.rho Bs.ψ (cA.symm (cA u)) (ΦD - ΨD)) = _
        rw [AddEquiv.symm_apply_apply]
      rw [← e2, this]; rfl)
    exact sub_eq_zero.1 h0
  have toS : ∀ ΦD ∈ GlobalTheory.WeilM.schA D.host.F (Fin W.rank × Fin (W.rank + W₁.rank)), dF ΦD ∈ algF Bs.ψ θ true A B →
      ΦD ∈ algD Γ.M Bs.ψ Bs.emb := by
    intro ΦD h hF
    obtain ⟨ΨD, hΨ, hd⟩ := hO.algA _ hF
    rw [inj ΦD h ΨD (hS _ hΨ) (hdat _ _ hd)]
    exact hΨ
  have hWf : ∀ h' ∈ GfC X, ∀ ΦD ∈ algD Γ.M Bs.ψ Bs.emb, om (1, kapX X e hO.JX h') ΦD ∈ algD Γ.M Bs.ψ Bs.emb ∧
      dF (om (1, kapX X e hO.JX h') ΦD) = ωA (1, h') (dF ΦD) := by
    intro h' hh' ΦD hΦD
    have hd := hO.weilA ΦD (dF ΦD) (hdat' ΦD (hS _ hΦD)) 1 h'
    rw [GlobalTheory.LocWeilAct.conjU_one'] at hd
    have e1 := hdat _ _ hd
    refine ⟨toS _ hd.1 ?_, e1.symm⟩
    rw [← e1]
    exact hm.mapA.stabX.1 h' hh' _ (hAlgF _ hΦD)
  have hVf : ∀ g' ∈ GfC W, ∀ ΦD ∈ algD Γ.M Bs.ψ Bs.emb,
      om (GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 hO.JW g', 1) ΦD ∈ algD Γ.M Bs.ψ Bs.emb ∧
      dF (om (GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 hO.JW g', 1) ΦD) = ωA (g', 1) (dF ΦD) := by
    intro g' hg' ΦD hΦD
    have hd := hO.weilA ΦD (dF ΦD) (hdat' ΦD (hS _ hΦD)) g' 1
    rw [GlobalTheory.KapXLine.kapX_one] at hd
    have e1 := hdat _ _ hd
    refine ⟨toS _ hd.1 ?_, e1.symm⟩
    rw [← e1]
    exact hm.mapA.stabM.1 g' hg' _ (hAlgF _ hΦD)
  let K : Submodule ℂ ((Fin W.rank × Fin (W.rank + W₁.rank) → AF D.host.F) → ℂ) :=
    { carrier := {ΦD | ΦD ∈ algD Γ.M Bs.ψ Bs.emb ∧ p (dF ΦD) = 0}
      add_mem' := by
        rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
        refine ⟨add_mem ha hb, ?_⟩
        rw [dF_add a (hS _ ha) b (hS _ hb), map_add (f := _), ha', hb', add_zero]
      zero_mem' := ⟨zero_mem _, by rw [dF_zero, map_zero]⟩
      smul_mem' := by
        rintro c a ⟨ha, ha'⟩
        refine ⟨Submodule.smul_mem _ c ha, ?_⟩
        rw [dF_smul c a (hS _ ha), map_smul, ha', smul_zero] }
  have memK : ∀ ΦD, ΦD ∈ K ↔ ΦD ∈ algD Γ.M Bs.ψ Bs.emb ∧ p (dF ΦD) = 0 := fun _ => Iff.rfl
  refine ⟨K, ⟨⟨fun x hx => hx.1, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  ·
    rintro v h hh ΦD ⟨hΦD, hp0⟩
    obtain ⟨h', hh', rfl⟩ := kapX_onto_local D X e Γ.W hO.JX v h hh
    obtain ⟨h1, h2⟩ := hWf h' hh' ΦD hΦD
    refine ⟨h1, ?_⟩
    rw [h2, hm.mapA.eqf h' hh' _ (hAlgF _ hΦD), hp0, map_zero]
  · rintro k hk ΦD ⟨hΦD, hp0⟩
    have h1 := _root_.GlobalTheory.T.square_agree_stabilizer_compact_weyl hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
      Pi rf rl p p' hm k hk ΦD hΦD
    exact ⟨h1, _root_.GlobalTheory.T.square_agree_kernel_compact_stable hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
      Pi rf rl p p' hm k hk ΦD hΦD _ _ (hdat' _ (hS _ hΦD)) (hdat' _ (hS _ h1)) hp0⟩
  · rintro γ hγ ΦD ⟨hΦD, hp0⟩ Φ₁ hΦ₁ hder
    exact ⟨hΦ₁, _root_.GlobalTheory.T.line_kernel_projection_weyl hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
      Pi rf rl p p' hm γ hγ ΦD hΦD Φ₁ hΦ₁ hder _ _ (hdat' _ (hS _ hΦD)) (hdat' _ (hS _ hΦ₁)) hp0⟩
  ·
    intro v g hg ΦD hΦD
    have hg' := GlobalTheory.SquareAgree.CoinvPass.conjUInv_mem_GfC W Γ.V 1 one_ne_zero hO.JW v g hg
    have eg : GlobalTheory.IndefiniteRowSideFullHecke.UnitaryConjugation.conjU W 1 hO.JW (GlobalTheory.ConjUTransport.conjUInv W 1 one_ne_zero hO.JW g) = g :=
      (GlobalTheory.ConjUTransport.conjEquiv W 1 one_ne_zero hO.JW).apply_symm_apply g
    obtain ⟨h1, h2⟩ := hVf _ hg' ΦD hΦD
    rw [eg] at h1 h2
    refine ⟨sub_mem h1 hΦD, ?_⟩
    rw [dF_sub _ (hS _ h1) _ (hS _ hΦD), map_sub, h2, hm.mapA.invf _ hg' _ (hAlgF _ hΦD), sub_self]
  · intro k hk ΦD hΦD
    have h1 := _root_.GlobalTheory.T.weil_algebraic_subspace_kInfty_stable hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
      Pi rf rl p p' hm k hk ΦD hΦD
    refine ⟨sub_mem h1 hΦD, ?_⟩
    rw [dF_sub _ (hS _ h1) _ (hS _ hΦD), map_sub,
      _root_.GlobalTheory.T.weil_projection_kInfty_invariant hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
        Pi rf rl p p' hm k hk ΦD hΦD _ _ (hdat' _ (hS _ hΦD)) (hdat' _ (hS _ h1)), sub_self]
  · intro γ hγ ΦD hΦD Φ₁ hΦ₁ hder
    exact ⟨hΦ₁, _root_.GlobalTheory.T.theta_line_vector_annihilation hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
      Pi rf rl p p' hm γ hγ ΦD hΦD Φ₁ hΦ₁ hder _ (hdat' _ (hS _ hΦ₁))⟩
  ·
    intro hK
    have hnt := hm.irred.1
    have : ∃ Φ ∈ algF Bs.ψ θ true A B, p Φ ≠ 0 := by
      by_contra hc
      push_neg at hc
      have hb : (algF Bs.ψ θ true A B).map p = ⊥ := by
        rw [eq_bot_iff]
        rintro _ ⟨Φ, hΦ, rfl⟩
        exact (Submodule.mem_bot ℂ).2 (hc Φ hΦ)
      rw [hm.mapA.onto] at hb
      exact top_ne_bot hb
    obtain ⟨Φ, hΦ, hp⟩ := this
    obtain ⟨ΦD, hΦD, hd⟩ := hO.algA Φ hΦ
    have hK' : ΦD ∈ K := hK ▸ hΦD
    exact hp (by rw [hdat _ _ hd]; exact hK'.2)
  ·
    intro N hN hKN
    have hNS : ∀ ΦD ∈ N, ΦD ∈ algD Γ.M Bs.ψ Bs.emb := fun ΦD h => hN.1.1 h
    let NI : Submodule ℂ Pi :=
      { carrier := {y | ∃ ΦD ∈ N, p (dF ΦD) = y}
        add_mem' := by
          rintro _ _ ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
          exact ⟨a + b, add_mem ha hb, by rw [dF_add a (hS _ (hNS _ ha)) b (hS _ (hNS _ hb)), map_add (f := _)]⟩
        zero_mem' := ⟨0, zero_mem _, by rw [dF_zero, map_zero]⟩
        smul_mem' := by
          rintro c _ ⟨a, ha, rfl⟩
          exact ⟨c • a, Submodule.smul_mem _ c ha, by rw [dF_smul c a (hS _ (hNS _ ha)), map_smul]⟩ }
    have hirr := hm.irred.2 NI ?_ ?_
    · rcases hirr with hb | ht
      · left
        refine le_antisymm (fun ΦD hΦD => ⟨hNS _ hΦD, ?_⟩) hKN
        have : p (dF ΦD) ∈ NI := ⟨ΦD, hΦD, rfl⟩
        rw [hb] at this
        exact (Submodule.mem_bot ℂ).1 this
      · right
        refine le_antisymm (fun ΦD h => hNS _ h) (fun ΦD hΦD => ?_)
        have : p (dF ΦD) ∈ NI := by rw [ht]; trivial
        obtain ⟨ΨD, hΨ, he⟩ := this
        have hd : ΦD - ΨD ∈ K := ⟨sub_mem hΦD (hNS _ hΨ), by
          rw [dF_sub _ (hS _ hΦD) _ (hS _ (hNS _ hΨ)), map_sub, he, sub_self]⟩
        have := add_mem (hKN hd) hΨ
        rwa [sub_add_cancel] at this
    · rintro g hg _ ⟨ΦD, hΦD, rfl⟩
      refine ⟨_, _root_.GlobalTheory.T.finite_adelic_stabilizer_fixes_kappa hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ Xc om om' cA cB hθ hTr hO hT
        Pi rf rl p p' hm N hN.1 g hg ΦD hΦD, ?_⟩
      rw [(hWf g hg ΦD (hNS _ hΦD)).2, hm.mapA.eqf g hg _ (hAlgF _ (hNS _ hΦD))]
    · rintro τ Y hY _ ⟨ΦD, hΦD, rfl⟩
      obtain ⟨Φ₁D, hΦ₁D, Φ₁, hΦ₁, hd, hder⟩ := _root_.GlobalTheory.T.weil_lie_algebra_action_by_line_derivatives hP D Bs.ψ θ W W₁ X A A₁ B α β ν 𝓕 ν₁ 𝓕₁ ωA ωB e Bs Γ
        Xc om om' cA cB hθ hTr hO hT Pi rf rl p p' hm N hN.1 τ Y hY ΦD hΦD (dF ΦD) (hdat' _ (hS _ (hNS _ hΦD)))
      refine ⟨Φ₁D, hΦ₁D, ?_⟩
      rw [← hdat _ _ hd]
      exact hm.mapA.eql τ Y hY _ (hAlgF _ (hNS _ hΦD)) _ hΦ₁ hder
  ·
    intro Φ _ ΦD hΦD hd
    rw [hdat _ _ hd]
    exact ⟨fun h => h.2, fun h => ⟨hΦD, h⟩⟩
end
end

