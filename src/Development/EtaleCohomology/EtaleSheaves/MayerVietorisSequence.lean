  obtain ⟨U₂, f₂, p₂, m₂, e₂, l₂, s₂⟩ := h2 V W
  refine ⟨U₁, U₂, f₁, f₂, p₁, p₂, m₁, m₂, ?_, e₁, l₁, e₂, l₂⟩
  intro n X x
