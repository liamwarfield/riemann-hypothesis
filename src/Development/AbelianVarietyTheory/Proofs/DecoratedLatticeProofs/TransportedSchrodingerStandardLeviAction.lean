theorem finIn_mem_idAt (z : Formalism.MainNotions.GlobalTheoryTheory.GenusMassVolumes.Af D.host.F ⊗[D.host.F] D.host.E) :
    GlobalTheory.FinPlLoc.finIn D z ∈ idAt D (fun _ => True) := by
