theorem commute_of_off {F E : Type} [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] {n : ℕ}
    {v : HeightOneSpectrum (𝓞 F)} {x k : GL (Fin n) (AfE F E)} (hx : ∀ w, w ≠ v → bc (prV (E := E) w) x = 1)
