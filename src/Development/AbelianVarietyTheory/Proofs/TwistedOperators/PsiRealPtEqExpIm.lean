    f₁ = f₂ := by
  intro D ψ _ S T f₁ f₂ h₁ h₂ h
  refine (denseRange_ratW_add_realPt S T).equalizer h₁.cont h₂.cont (funext fun p => ?_)
  simp only [Function.comp_apply]
