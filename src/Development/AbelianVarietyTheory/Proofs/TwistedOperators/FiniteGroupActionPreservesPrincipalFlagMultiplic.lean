theorem gram_family (S : HSpace E) {ι : Type} [Fintype ι] (v : ι → S.V) :
    (Matrix.of fun k l => S.hT (v k) (v l)) =
      (Matrix.of fun i k => S.frame.repr (v k) i)ᴴ * S.gram * Matrix.of fun i k => S.frame.repr (v k) i := by
