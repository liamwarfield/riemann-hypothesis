    Formalism.L2.DIV.redFn β PP (Lev.finE V k) = 1 :=
  redFn_eq_one_of_cols hβ PP _ hk b hb fun j =>
    col_cong D V L β hβ k PP b h _ (GlobalTheory.ChainOnto.LStab.col_mem_hatL hβ j)

