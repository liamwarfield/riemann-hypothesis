theorem acts_of_torusEndOf (g : GtCoord I D e G) (a : thickObj R I e G ⟶ thickObj R I e G)
    {f : D.X → D.X} {t : splitTorus _ D.X ⟶ splitTorus _ D.X} (ht : TorusEndOf D.X f t)
