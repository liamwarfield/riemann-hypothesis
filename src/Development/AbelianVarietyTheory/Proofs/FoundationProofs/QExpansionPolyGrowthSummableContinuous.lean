theorem firstCol_ne_zero (q : ℕ) [Fact q.Prime] (γ : SL(2, ℤ))
    (h0 : (((γ : M2) 0 0 : ℤ) : ZMod q) = 0) (h1 : (((γ : M2) 1 0 : ℤ) : ZMod q) = 0) : False := by
  have hd : (γ : M2).det = 1 := γ.2
  rw [Matrix.det_fin_two] at hd
