  first | exact @GlobalTheory.EichlerLimit.polySlash_eichler_limit | exact GlobalTheory.EichlerLimit.polySlash_eichler_limit | (intros; apply GlobalTheory.EichlerLimit.polySlash_eichler_limit <;> assumption)
