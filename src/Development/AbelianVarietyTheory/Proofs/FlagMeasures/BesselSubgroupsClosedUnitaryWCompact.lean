    (idx_inf_le _ _ _ (rs (𝓞 K) (wSp N.F N.F')) hLaL (hLa0.trans inf_le_right) hq0).2.trans hB
  have hi0 : N.iI g Λ ≠ 0 := fun h0 => hp0 (by rw [← hmul, h0, zero_mul])
