    apply TensorProduct.AlgebraTensorModule.ext
    intro v b
    have := (pc P h hN hF hS).actB_eq x b
    simp [actVB, Formalism.WeaklyAdmissibleFiltrations.PotCrysData.resH] at this ⊢
    rw [this]
