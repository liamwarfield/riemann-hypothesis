  have hωZ : ω ∈ D₁.Zl := hw₁ω ▸ D₁.Lc_mem_Zl hw₁
  have hl : ((l : K) ^ c) ≠ 0 := pow_ne_zero _ (l_ne_zero (K := K) l)
  have hrange : (⟨ω, hωZ⟩ : D₁.Zl) ∈ LinearMap.range D₁.LcZ := ⟨⟨w₁, hw₁⟩, Subtype.ext hw₁ω⟩
