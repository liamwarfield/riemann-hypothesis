  intro O K _ _ _ _ _ _ l e a ι _ _ _ _ _ _ _ κ _ _ η H D₀ D₁ F U hIm ω hω c hc
  obtain ⟨w₁, hw₁, hw₁ω⟩ := hω
  obtain ⟨w₀, hw₀, hw₀ω⟩ := hc
  let W : Submodule K D₁.Zl := (D₀.Zl.map F.onPol).comap D₁.Zl.subtype
