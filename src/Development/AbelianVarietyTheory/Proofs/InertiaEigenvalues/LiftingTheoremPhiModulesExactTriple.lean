  have h2 : (⟨ω, hωZ⟩ : D₁.Zl) ∈ W.map D₁.LcZ := hmap ▸ ⟨hrange, hmemW⟩
  obtain ⟨z, ⟨x, hx, hxz⟩, hzω⟩ := h2
