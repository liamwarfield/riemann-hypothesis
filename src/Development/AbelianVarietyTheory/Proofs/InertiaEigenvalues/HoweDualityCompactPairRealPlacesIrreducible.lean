  have hθ : IsInfFam R.θ := hF.vac.2.inf
  have hBS : ∀ τ, (R.BV i τ)ᴴ * gramAt D (Vc D i) τ * R.BV i τ = 1 := fun τ => onb_posDef (hC.models.BV i τ)
  have eu : ∀ (g : GLR D (Vc D i).rank) τ,
