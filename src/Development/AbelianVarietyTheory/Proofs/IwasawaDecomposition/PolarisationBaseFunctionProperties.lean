      obtain ⟨hL, hr, ⟨c', hc'⟩, hs⟩ := hC (Sp V) (Sp W) t.G _ (cubeMapOf h) t.PP t.cub
      have hact : ∀ a, ((OAct.pullback f t.G t.act).act a).left ≫ pullback.fst t.G.hom f =
