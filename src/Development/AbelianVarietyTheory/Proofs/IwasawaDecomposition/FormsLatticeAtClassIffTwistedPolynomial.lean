theorem prSC_int_iff (hW : WeylLatticeDuality.Stmt) {D : D7} (Pl : Examples₂.EntPl D) (O : ∀ u μ, GL3Theta.LiftObj D (D.chTw u μ)) (Bs : PlaceMatrixFamily D)
