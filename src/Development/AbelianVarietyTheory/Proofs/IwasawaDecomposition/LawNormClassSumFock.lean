  first | exact @GlobalTheory.FourCopiesIso.nonempty_isoKG | exact GlobalTheory.FourCopiesIso.nonempty_isoKG | (intros; apply GlobalTheory.FourCopiesIso.nonempty_isoKG <;> assumption)
