theorem exists_finset_leftTransversal_of_relIndex_ne_zero : ∀ {G : Type} [Group G] (H K : Subgroup G),
    K ≤ H → K.relIndex H ≠ 0 → ∃ R : Finset G, (∀ r ∈ R, r ∈ H) ∧ ∀ k ∈ H, ∃! r, r ∈ R ∧ r⁻¹ * k ∈ K := by
  intro G _ H K _ hrel
  have hfin : Finite (H ⧸ K.subgroupOf H) := by
    apply Nat.finite_of_card_ne_zero
    simpa [Subgroup.relIndex, Subgroup.index] using hrel
  let f : H ⧸ K.subgroupOf H → G := fun q => ((Quotient.out q : H) : G)
  have hR : (Set.range f).Finite := Set.finite_range f
  refine ⟨hR.toFinset, ?_, ?_⟩
  · intro r hr
    rw [Set.Finite.mem_toFinset] at hr
    obtain ⟨q, rfl⟩ := hr
    exact (Quotient.out q : H).2
  · intro k hk
    refine ⟨f (QuotientGroup.mk (⟨k, hk⟩ : H)), ⟨?_, ?_⟩, ?_⟩
    · rw [Set.Finite.mem_toFinset]; exact ⟨_, rfl⟩
    · have h1 : (QuotientGroup.mk (Quotient.out (QuotientGroup.mk (⟨k, hk⟩ : H) : H ⧸ K.subgroupOf H)) :
          H ⧸ K.subgroupOf H) = QuotientGroup.mk ⟨k, hk⟩ := QuotientGroup.out_eq' _
      rw [QuotientGroup.eq, Subgroup.mem_subgroupOf] at h1
      simpa [f] using h1
    · rintro r ⟨hr, hrk⟩
      rw [Set.Finite.mem_toFinset] at hr
      obtain ⟨q, rfl⟩ := hr
      have h2 : (QuotientGroup.mk (Quotient.out q) : H ⧸ K.subgroupOf H) = QuotientGroup.mk ⟨k, hk⟩ := by
        rw [QuotientGroup.eq, Subgroup.mem_subgroupOf]
        simpa [f] using hrk
      rw [QuotientGroup.out_eq'] at h2
      simp [f, h2]

end GlobalTheory
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.EtaleAdjoinRootXPowSubC
open IsLocalRing Polynomial

namespace GlobalTheory

theorem etale_adjoinRoot_X_pow_sub_C : ∀ (R : Type) [CommRing R] (n : ℕ) (u : R), IsUnit (n : R) →
    IsUnit u → Algebra.Etale R (AdjoinRoot (Polynomial.X ^ n - Polynomial.C u : Polynomial R)) := by
  intro R _ n u hn hu
  set f : R[X] := X ^ n - C u with hfdef
  have key : f.Monic ∧ IsUnit (AdjoinRoot.mk f (derivative f)) := by
    by_cases hn0 : n = 0
    · subst hn0
      have h01 : (0 : R) = 1 := isUnit_zero_iff.1 (by simpa using hn)
      have : Subsingleton R := subsingleton_of_zero_eq_one h01
      have : Subsingleton (AdjoinRoot f) := (AdjoinRoot.of f).codomain_trivial
      exact ⟨Subsingleton.elim _ _, isUnit_of_subsingleton _⟩
    have hm : f.Monic := monic_X_pow_sub_C _ hn0
    have h1 : AdjoinRoot.root f ^ n = algebraMap R _ u := by
      have := AdjoinRoot.eval₂_root f
      simpa [hfdef, sub_eq_zero] using this
    have hr : IsUnit (AdjoinRoot.root f) :=
      (isUnit_pow_iff hn0).1 (h1 ▸ hu.map _)
    refine ⟨hm, ?_⟩
    have e : AdjoinRoot.mk f (derivative f) = algebraMap R _ (n : R) * AdjoinRoot.root f ^ (n - 1) := by
      simp [hfdef, derivative_X_pow, AdjoinRoot.algebraMap_eq]
    rw [e]
    exact (hn.map _).mul (hr.pow _)
  obtain ⟨hm, h⟩ := key
  let P : StandardEtalePair R := ⟨f, hm, derivative f, 1, 0, 1, by simp⟩
  exact .of_equiv (P.equivAwayAdjoinRoot.trans
    ((IsLocalization.atUnit _ (Localization.Away (AdjoinRoot.mk f (derivative f))) _
      h).symm.restrictScalars R))

end GlobalTheory
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.LocHomAlgebraMap
open IsLocalRing

namespace GlobalTheory.AbhyankarLocal

variable (S L D : Type) [CommRing S] [Field L] [Algebra S L] [CommRing D] [Algebra S D]

noncomputable def toNorm : integralClosure S L →+* integralClosure D (TensorProduct S D L) :=
  RingHom.codRestrict
    ((Algebra.TensorProduct.includeRight (R := S) (A := D) (B := L)).toRingHom.comp
      (integralClosure S L).val.toRingHom)
    (integralClosure D (TensorProduct S D L)) (fun o => by
      have h : IsIntegral S (Algebra.TensorProduct.includeRight (R := S) (A := D) (B := L) (o : L)) :=
        o.2.map _
      exact h.tower_top)

@[simp] theorem toNorm_coe (o : integralClosure S L) :
    ((toNorm S L D o : integralClosure D (TensorProduct S D L)) : TensorProduct S D L) =
      (1 : D) ⊗ₜ[S] (o : L) := rfl

variable {S L D}

noncomputable def locHom (Q : Ideal (integralClosure D (TensorProduct S D L))) [Q.IsPrime] :
    Localization.AtPrime (Q.comap (toNorm S L D)) →+* Localization.AtPrime Q :=
  IsLocalization.lift (M := (Q.comap (toNorm S L D)).primeCompl)
    (g := (algebraMap _ (Localization.AtPrime Q)).comp (toNorm S L D)) (fun s =>
      IsLocalization.map_units (Localization.AtPrime Q) (⟨toNorm S L D s, s.2⟩ : Q.primeCompl))

theorem locHom_algebraMap (Q : Ideal (integralClosure D (TensorProduct S D L))) [Q.IsPrime]
    (o : integralClosure S L) :
    locHom Q (algebraMap _ _ o) = algebraMap _ (Localization.AtPrime Q) (toNorm S L D o) :=
  IsLocalization.lift_eq _ _

end GlobalTheory.AbhyankarLocal
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.DivMemOfMulPowDivMemOfRegularPair
namespace GlobalTheory

theorem div_mem_of_mul_pow_div_mem_of_regularPair (K : Type) [Field K] (O : Subring K) (s t : K)
    (ht : t ∈ O) (h : ∀ g ∈ O, g * t / s ∈ O → g / s ∈ O) (N : ℕ) :
    ∀ g ∈ O, g * t ^ N / s ∈ O → g / s ∈ O := by
  induction N with
  | zero => intro g _ hg; simpa using hg
  | succ N ih =>
    intro g hg hgN
    apply ih g hg
    apply h _ (O.mul_mem hg (O.pow_mem ht N))
    rwa [mul_assoc, ← pow_succ]

theorem regularPair_pow : ∀ (K : Type) [Field K] (O : Subring K) (s t : K), s ∈ O → t ∈ O → s ≠ 0 → (∀ g ∈ O, g * t / s ∈ O → g / s ∈ O) → ∀ (m N : ℕ), ∀ g ∈ O, g * t ^ N / s ^ m ∈ O → g / s ^ m ∈ O := by
  intro K _ O s t hs ht hs0 h m N
  induction m with
  | zero => intro g hg _; simpa using hg
  | succ m ih =>
    intro g hg hgN
    have h1 : g * t ^ N / s ∈ O := by
      have h2 := O.mul_mem hgN (O.pow_mem hs m)
      have e : g * t ^ N / s ^ (m + 1) * s ^ m = g * t ^ N / s := by
        field_simp
        ring
      rwa [e] at h2
    have h3 := div_mem_of_mul_pow_div_mem_of_regularPair K O s t ht h N g hg h1
    have e1 : g / s * t ^ N / s ^ m = g * t ^ N / s ^ (m + 1) := by
      field_simp
      ring
    have e2 : g / s / s ^ m = g / s ^ (m + 1) := by
      field_simp
      ring
    rw [← e2]
    exact ih _ h3 (by rwa [e1])

end GlobalTheory
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.AbsNormMapRingOfIntegersHom
open NumberField

namespace GlobalTheory

theorem absNorm_map_ringOfIntegers_hom (E K : Type) [Field E] [NumberField E] [Field K]
    [NumberField K] (τ : 𝓞 E →+* 𝓞 K) (𝔞 : Ideal (𝓞 E)) :
    Module.finrank ℚ E ∣ Module.finrank ℚ K ∧
      Ideal.absNorm (𝔞.map τ) = Ideal.absNorm 𝔞 ^ (Module.finrank ℚ K / Module.finrank ℚ E) := by
  have hτinj : Function.Injective τ := by
    rw [RingHom.injective_iff_ker_eq_bot]
    apply Ideal.eq_bot_of_comap_eq_bot (R := ℤ)
    ext n
    simp only [Ideal.mem_comap, RingHom.mem_ker, Ideal.mem_bot]
    rw [eq_intCast, map_intCast]
    constructor
    · intro h
      have : ((n : 𝓞 K) : K) = 0 := by rw [h]; rfl
      exact_mod_cast this
    · rintro rfl; simp
  have hinj : Function.Injective ((algebraMap (𝓞 K) K).comp τ) :=
    (RingOfIntegers.coe_injective (K := K)).comp hτinj
  let φ : E →+* K := IsFractionRing.lift hinj
  letI : Algebra E K := φ.toAlgebra
  have hmap : τ = algebraMap (𝓞 E) (𝓞 K) := by
    ext x
    change ((algebraMap (𝓞 K) K).comp τ) x = φ (algebraMap (𝓞 E) E x)
    rw [IsFractionRing.lift_algebraMap]
  have htower := Module.finrank_mul_finrank ℚ E K
  have hE : 0 < Module.finrank ℚ E := Module.finrank_pos
  refine ⟨⟨Module.finrank E K, htower.symm⟩, ?_⟩
  have hq : Module.finrank ℚ K / Module.finrank ℚ E = Module.finrank E K := by
    rw [← htower, Nat.mul_div_cancel_left _ hE]
  rw [hq, hmap, Ideal.absNorm_algebraMap (𝓞 E) (𝓞 K) 𝔞,
    ← IsFractionRing.finrank_eq (𝓞 E) E (𝓞 K) K]

end GlobalTheory
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.CardFiberEqOfSumEq
open Polynomial

namespace GlobalTheory.CharDeg

theorem card_fiber_eq_of_sum_eq {M : Type} [Monoid M] {n : ℕ} (f g : Fin n → (M →* ℂ))
    (h : ∀ x, ∑ j, f j x = ∑ j, g j x) (ψ : M →* ℂ) :
    Nat.card {j // f j = ψ} = Nat.card {j // g j = ψ} := by
  classical
  have hli := linearIndependent_monoidHom M ℂ
  set s : Finset (M →* ℂ) := Finset.univ.image f ∪ Finset.univ.image g ∪ {ψ} with hs
  have key : ∀ u : Fin n → (M →* ℂ), (∀ j, u j ∈ s) →
      ∑ φ ∈ s, ((Finset.univ.filter fun j => u j = φ).card : ℂ) • (φ : M → ℂ) = ∑ j, (u j : M → ℂ) := by
    intro u hu
    rw [← Finset.sum_fiberwise_of_maps_to (s := Finset.univ) (t := s) (g := u) (fun j _ => hu j)
      (fun j => (u j : M → ℂ))]
    refine Finset.sum_congr rfl fun φ _ => ?_
    have hc : ∑ j ∈ Finset.univ.filter (fun j => u j = φ), (u j : M → ℂ)
        = ∑ j ∈ Finset.univ.filter (fun j => u j = φ), (φ : M → ℂ) :=
      Finset.sum_congr rfl fun j hj => by rw [(Finset.mem_filter.mp hj).2]
    rw [hc, Finset.sum_const, Nat.cast_smul_eq_nsmul]
  have hzero : ∑ φ ∈ s, (((Finset.univ.filter fun j => f j = φ).card : ℂ)
      - ((Finset.univ.filter fun j => g j = φ).card : ℂ)) • (φ : M → ℂ) = 0 := by
    simp only [sub_smul, Finset.sum_sub_distrib]
    rw [key f (fun j => by simp [hs]), key g (fun j => by simp [hs]), sub_eq_zero]
    funext x
    simp [Finset.sum_apply, h x]
  have hψ := linearIndependent_iff'.mp hli s _ hzero ψ (by simp [hs])
  rw [sub_eq_zero, Nat.cast_inj] at hψ
  simpa [Nat.card_eq_fintype_card, Fintype.card_subtype] using hψ

theorem sum_eq_of_prod_eq {n : ℕ} (a b : Fin n → ℂ)
    (h : ∏ j, (X - C (a j)) = ∏ j, (X - C (b j))) : ∑ j, a j = ∑ j, b j := by
  have := congrArg Polynomial.nextCoeff h
  rw [Polynomial.prod_X_sub_C_nextCoeff, Polynomial.prod_X_sub_C_nextCoeff] at this
  exact neg_inj.mp this

end GlobalTheory.CharDeg
end

section -- merged from Development.AbelianVarietyTheory.Proofs.DivisorProofs.SumTransversalLeftTranslateInvariant
namespace GlobalTheory

theorem sum_transversal_left_translate_invariant :
    ∀ {G X : Type} [Group G] [AddCommMonoid X] (H K : Subgroup G) (R : Finset G) (f : G → X),
      (∀ r ∈ R, r ∈ H) → (∀ k ∈ H, ∃! r, r ∈ R ∧ r⁻¹ * k ∈ K) →
      (∀ r ∈ H, ∀ c ∈ K, f (r * c) = f r) → ∀ k ∈ H, ∑ r ∈ R, f (k * r) = ∑ r ∈ R, f r := by
  intro G X _ _ H K R f hR hU hf k hk
  have hkH : ∀ a ∈ R, k * a ∈ H := fun a ha => H.mul_mem hk (hR a ha)
  refine Finset.sum_bij (fun a ha => Classical.choose (hU (k * a) (hkH a ha)).exists)
    (fun a ha => (Classical.choose_spec (hU (k * a) (hkH a ha)).exists).1) ?_ ?_ ?_
  · intro a₁ ha₁ a₂ ha₂ heq
    have h1 := (Classical.choose_spec (hU (k * a₁) (hkH a₁ ha₁)).exists).2
    have h2 := (Classical.choose_spec (hU (k * a₂) (hkH a₂ ha₂)).exists).2
    rw [heq] at h1
    set r' := Classical.choose (hU (k * a₂) (hkH a₂ ha₂)).exists
    have hm : a₁⁻¹ * a₂ ∈ K := by
      have := K.mul_mem (K.inv_mem h1) h2
      simpa [mul_assoc] using this
    have hu := (hU a₂ (hR a₂ ha₂)).unique (y₁ := a₁) (y₂ := a₂) ⟨ha₁, hm⟩ ⟨ha₂, by simpa using K.one_mem⟩
    exact hu
  · intro b hb
    have hb' : k⁻¹ * b ∈ H := H.mul_mem (H.inv_mem hk) (hR b hb)
    obtain ⟨a, ⟨ha, haK⟩, -⟩ := hU (k⁻¹ * b) hb'
    refine ⟨a, ha, ?_⟩
    have hs := Classical.choose_spec (hU (k * a) (hkH a ha)).exists
    have hbK : b⁻¹ * (k * a) ∈ K := by
      have := K.inv_mem haK
      simpa [mul_assoc] using this
    exact (hU (k * a) (hkH a ha)).unique hs ⟨hb, hbK⟩
  · intro a ha
    have hs := Classical.choose_spec (hU (k * a) (hkH a ha)).exists
    set r' := Classical.choose (hU (k * a) (hkH a ha)).exists
    have := hf r' (hR r' hs.1) (r'⁻¹ * (k * a)) hs.2
    rw [mul_inv_cancel_left] at this
    exact this

end GlobalTheory
end

