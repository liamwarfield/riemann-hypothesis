def ClauseB (S : IndefData Df) (O : FunData K Df) (C b : ℝ) : Prop :=
  ∃ g : InfinitePlace K → ℝ, (∀ v p, Df.Qp Bs.μ0 p ≠ ⊥ → g v ≤ ∑ j, Real.log (S.lam j Bs.μ0 p v)) ∧
