    have hcomp : jK V ≫ (spMap φ ≫ (spMap (M.stalkEquiv z).toRingHom ≫ M.Z.fromSpecStalk z)) = spMap emb ≫ M.pt := by
      rw [pt_eq_comp M z, ← Category.assoc, e1, Category.assoc]
