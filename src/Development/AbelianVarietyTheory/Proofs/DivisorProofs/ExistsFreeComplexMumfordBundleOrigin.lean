  refine ⟨C, hC, ⟨_, h0⟩, SecKernel.nonempty_equiv_of_model ψ hF hs.1 hD hq hC P, ?_, ?_⟩
  · intro K _ _ φ X' π f' hX i hi
    let t := Spec.map (CommRingCat.ofHom φ)
    let B' := (Over.pullback t).obj B
