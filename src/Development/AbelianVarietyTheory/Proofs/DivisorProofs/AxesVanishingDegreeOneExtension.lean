  have e : pr (σ y) = y := by
    have := congrArg (fun f : X₀ ⟶ X₀ ↦ f y) hσ
    simpa only [Scheme.Hom.comp_apply] using this.trans (by simp)
  change σ (pr (σ y)) ∈ U ↔ σ y ∈ U
  rw [e]

end GlobalTheory.SqZeroBC
