    rw [Measure.map_smul _ (measurable_const_mul _).aemeasurable,
      Measure.map_map (measurable_const_mul _) (hm a), smul_smul, map_mul,
      inv_mul_cancel_left₀ (distribHaarChar_pos).ne']
    congr 2
