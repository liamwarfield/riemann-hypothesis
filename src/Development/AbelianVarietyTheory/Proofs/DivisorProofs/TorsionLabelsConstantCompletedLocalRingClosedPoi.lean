    rw [hζR, ← map_pow, ← map_pow, ← map_pow, S.prim.pow_eq_one, map_one, map_one, map_one]
  let u0 : Rˣ := Units.ofPowEqOne ζR ((S.r * S.N) ^ 2) hζpow (pow_ne_zero 2 hk0)
