    have e1 : h.left ≫ g₀.b.left = h.left ≫ (1 : N ⟶ D.toPre.P.A).left := by
      have t1 : gT.b.left = h.left ≫ g₀.b.left := hh.1
      have t2 : gT.b = 1 := (hgT 0).1
      have t3 : h ≫ (1 : N ⟶ D.toPre.P.A) = 1 := MonObj.comp_one h
