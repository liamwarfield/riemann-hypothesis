    rw [← pow_mul, mul_comm, pow_mul, hw, one_pow]
  have hsemi : IsSemiAbelian G := by
    obtain ⟨e, he, -⟩ := grpPullback_iso hpb (isGrpPullback_pullback FinalForm.G _)
    haveI := he
