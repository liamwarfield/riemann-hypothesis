  let x' := IsOpenImmersion.lift (W i).ι x hr
  have hx' : x' ≫ (W i).ι = x := IsOpenImmersion.lift_fac _ _ _
  have := hT i K x' c (by rw [← Category.assoc, hx']; exact hc)
  rw [← hx', Category.assoc, hfW i]; exact this

