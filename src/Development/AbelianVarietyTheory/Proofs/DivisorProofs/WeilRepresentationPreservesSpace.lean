  set_option synthInstance.maxHeartbeats 100000 in
    rw [map_sum, Finset.sum_eq_single w (fun w' _ hne => evFin_idemAt_ne (Ne.symm hne)) (fun h => absurd hw h),
    evFin_idemAt]

