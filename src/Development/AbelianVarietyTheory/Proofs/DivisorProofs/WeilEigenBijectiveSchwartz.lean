theorem symp_fromCols {d : Darboux (symp c ξ JA JB) κ} {dd : Darboux (symp c ξ JA (dbl JB)) (κ ⊕ κ)}
    (h : IsDblCoord c ξ JA JB d dd) (w₁ w₂ w₁' w₂' : Matrix α β E) :
    symp c ξ JA (dbl JB) (Matrix.fromCols w₁ w₂) (Matrix.fromCols w₁' w₂') =
