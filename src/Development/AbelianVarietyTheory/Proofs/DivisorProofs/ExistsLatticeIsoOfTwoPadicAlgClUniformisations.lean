  let x' : TFK (R := V') F ⟶ A'.A := Over.homMk (gp.1.lift x.left (jFK (R := V') F) w) (gp.1.lift_snd _ _ _)
  have hx : x'.left ≫ ψ = x.left := gp.1.lift_fst _ _ _
