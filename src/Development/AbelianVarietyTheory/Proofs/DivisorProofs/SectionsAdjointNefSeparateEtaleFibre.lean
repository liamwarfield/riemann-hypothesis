    N₀ 2 x₀ two_pos hn₀ hb₀ hx₀c (fun Z e hZ hxZ he hdim => by
      have h1 := hpos Z e hZ (hrange Z hxZ) he hdim
      have h2 := GlobalTheory.mixExp_interNumRed hNN ℂ W p hp N N N₀ hN hN h₀ (2 * c₀ + 1) 0 Z e hNn hNn hc₀ hdim
