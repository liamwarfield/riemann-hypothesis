lemma cc_cc' (a : E) : cc (cc a) = a := IsCMField.complexConj_apply_apply E a

lemma herm_sub_left' {r : ℕ} (G : Matrix (Fin r) (Fin r) E) (u v y : Fin r → E) :
    herm G (u - v) y = herm G u y - herm G v y := by
