  · exact (ringKrullDim_eq_of_ringEquiv (stalkEquiv w')).symm.trans hdim
  · intro P hP h1 h2
    obtain ⟨P₀, rfl⟩ := (placeEquiv (s ≫ p)).surjective P
    obtain ⟨z, hzw', hz⟩ := (isPrimeOf_placeEquiv P₀ w').1 hP
    rw [hdisc P₀ z hz]
