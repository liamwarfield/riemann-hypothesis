    exact_mod_cast this
  · have h1 : Ideal.span {stalkEquiv w' t, stalkEquiv w' u} = (Ideal.span {t, u}).map (stalkEquiv w') := by
      rw [Ideal.map_span]; simp [Set.image_insert_eq]
    rw [h1, hspan]
    haveI := hQ.isLocalRing
