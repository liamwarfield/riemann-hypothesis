  choose z hzA hz using hex
  refine ⟨Matrix.of fun i j => z i j, ⟨?_, ?_⟩, ?_⟩
  · intro a ha
    ext i j
    simp only [Matrix.smul_apply, Matrix.of_apply, Matrix.zero_apply]
    exact hzA i j a ha
  · intro w
