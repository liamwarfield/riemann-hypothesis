  unfold hhJ
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun c _ => ?_)
  rw [norm_mul, inner_self_eq_norm_sq_to_K]
  split_ifs <;> simp

lemma hhJ_self_im_eq_zero (ε : Fin n → Bool) (x : Fin n → M) :
