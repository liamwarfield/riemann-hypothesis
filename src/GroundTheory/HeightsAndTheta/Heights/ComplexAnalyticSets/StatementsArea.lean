  refine ⟨d, A, O, Ψ.source, fun y => Ψ.symm (y, 0), hd,
    Ψ.open_target.preimage (continuous_id.prodMk continuous_const), Ψ.open_source, haΨ,
    fun t ht => (hsrc t ht).2.1, ?_, ?_, ?_⟩
