  exact (isSmoothHerm_fsHerm _).mul isSmoothHerm_fsMulti

theorem invTensor_a (k : K) : (invTensor ι).a k = ((0 : K → ℕ) k : ℤ) := by
  show (-1 : ℤ) + 1 = _
