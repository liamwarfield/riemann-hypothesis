  set H : (Fin e → ℂ) → ℝ := fun u => A.h (γ u) with hHdef
  have hblk : ∀ u ∈ V, ∀ k, ∃ i, γ u ⟨k, i⟩ ≠ 0 := fun u hu => (R.mem x0 _ hu.2).1
  have hHc : ContinuousOn H V := fun u hu =>
